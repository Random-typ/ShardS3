# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS builder
WORKDIR /src

COPY shards3/go.mod shards3/go.sum ./shards3/
RUN --mount=type=cache,target=/go/pkg/mod \
    cd shards3 && go mod download

COPY shards3 ./shards3
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd shards3 && CGO_ENABLED=0 GOOS=linux go build -o /out/s3-api ./cmd/s3-api

FROM alpine:3.22
WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY --from=builder /out/s3-api /usr/local/bin/s3-api

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/s3-api"]
