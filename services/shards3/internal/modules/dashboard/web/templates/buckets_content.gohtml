{{define "buckets_content"}}
<section class="panel">
  <div class="panel-head">
    <h2>Buckets</h2>
    <span class="badge">create / delete</span>
  </div>

  <div
    id="buckets-panel"
    class="bucket-list stack"
    hx-get="/fragments/buckets"
    hx-trigger="load"
    hx-swap="innerHTML"
  >
    <div class="muted">Loading buckets...</div>
  </div>
</section>
{{end}}